<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cashbook</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cashbook.styles.css" asp-append-version="true" />
</head>

<body>

    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <header class="app-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid app-navbar-container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark">C</span>
                    <span class="brand-text">Cashbook</span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Navigation öffnen">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav app-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(controller == "CashEntries" ? "active" : "")"
                               asp-controller="CashEntries"
                               asp-action="Index">
                                Kassenbuch
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(controller == "Invoices" ? "active" : "")"
                               asp-controller="Invoices"
                               asp-action="Index">
                                Rechnungen
                            </a>
                        </li>

                    </ul>

                    <div class="app-user-area">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="app-user-info">

                                <div class="app-user-avatar">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper())
                                </div>

                                <div class="app-user-text">
                                    <span class="app-user-label">
                                        Angemeldet als
                                    </span>

                                    <span class="app-user-name">
                                        @User.Identity.Name
                                    </span>
                                </div>

                            </div>
                        }

                        <partial name="_LoginPartial" />

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main class="app-main">
        <div class="container-fluid app-content-container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-fluid app-content-container app-footer-inner">
            <span>© 2026 Cashbook</span>

            <a asp-controller="Home"
               asp-action="Privacy">
                Datenschutz
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>