@model Cashbook.Models.Invoice

@{
    ViewData["Title"] = "Rechnungsdetails";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <h1 class="mb-0">@Model.InvoiceNumber</h1>

            @switch (Model.Status)
            {
                case Cashbook.Models.InvoiceStatus.Open:
                    <span class="badge bg-warning text-dark">Offen</span>
                    break;

                case Cashbook.Models.InvoiceStatus.Paid:
                    <span class="badge bg-success">Bezahlt</span>
                    break;

                case Cashbook.Models.InvoiceStatus.Cancelled:
                    <span class="badge bg-secondary">Storniert</span>
                    break;
            }
        </div>

        <p class="text-muted mb-0">
            Rechnungsdatum:
            @Model.InvoiceDate.ToString("dd.MM.yyyy")
        </p>
    </div>

    <div class="text-end">
        <div class="text-muted small">Bruttobetrag</div>
        <div class="invoice-total">
            @Model.GrossAmount.ToString("N2") €
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model.Status == Cashbook.Models.InvoiceStatus.Cancelled)
{
    <div class="alert alert-secondary">
        Diese Rechnung wurde storniert.
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="section-label mb-3">
                    Rechnungssteller
                </div>

                <h5 class="mb-2">@Model.IssuerName</h5>

                <div class="text-muted">
                    @Model.IssuerStreet<br />
                    @Model.IssuerPostalCode @Model.IssuerCity
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.IssuerVatIdentificationNumber))
                {
                    <div class="mt-3">
                        <span class="text-muted">UID:</span>
                        <span class="fw-medium">
                            @Model.IssuerVatIdentificationNumber
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="section-label mb-3">
                    Rechnungsempfänger
                </div>

                <h5 class="mb-2">@Model.RecipientName</h5>

                <div class="text-muted">
                    @Model.RecipientStreet<br />
                    @Model.RecipientPostalCode @Model.RecipientCity
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.RecipientVatIdentificationNumber))
                {
                    <div class="mt-3">
                        <span class="text-muted">UID:</span>
                        <span class="fw-medium">
                            @Model.RecipientVatIdentificationNumber
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-4">

            <div class="col-md-3">
                <div class="detail-label">Rechnungsart</div>
                <div class="detail-value">
                    @(Model.Type == Cashbook.Models.InvoiceType.Outgoing
                        ? "Ausgangsrechnung"
                        : "Eingangsrechnung")
                </div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Rechnungsdatum</div>
                <div class="detail-value">
                    @Model.InvoiceDate.ToString("dd.MM.yyyy")
                </div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Leistungsdatum</div>
                <div class="detail-value">
                    @Model.ServiceDate.ToString("dd.MM.yyyy")
                </div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Bezahlt am</div>
                <div class="detail-value">
                    @if (Model.PaidAt.HasValue)
                    {
                        @Model.PaidAt.Value.ToString("dd.MM.yyyy HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">–</span>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-0">

        <div class="px-4 pt-4">
            <h4 class="mb-3">Positionen</h4>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Beschreibung</th>
                        <th class="text-end">Menge</th>
                        <th class="text-end">Einzelpreis netto</th>
                        <th class="text-end">USt.</th>
                        <th class="text-end">Netto</th>
                        <th class="text-end">USt.-Betrag</th>
                        <th class="text-end">Brutto</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var net = Math.Round(
                            item.Quantity * item.UnitPrice,
                            2,
                            MidpointRounding.AwayFromZero);

                        var vat = Math.Round(
                            net * item.VatRate / 100m,
                            2,
                            MidpointRounding.AwayFromZero);

                        var gross = net + vat;

                        <tr>
                            <td class="fw-medium">
                                @item.Description
                            </td>

                            <td class="text-end">
                                @item.Quantity.ToString("N2")
                            </td>

                            <td class="text-end">
                                @item.UnitPrice.ToString("N2") €
                            </td>

                            <td class="text-end">
                                @item.VatRate.ToString("N2") %
                            </td>

                            <td class="text-end">
                                @net.ToString("N2") €
                            </td>

                            <td class="text-end">
                                @vat.ToString("N2") €
                            </td>

                            <td class="text-end fw-semibold">
                                @gross.ToString("N2") €
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

<div class="row justify-content-end mb-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">

                <div class="invoice-summary-row">
                    <span>Netto</span>
                    <span>@Model.NetAmount.ToString("N2") €</span>
                </div>

                <div class="invoice-summary-row">
                    <span>USt.</span>
                    <span>@Model.VatAmount.ToString("N2") €</span>
                </div>

                <div class="invoice-summary-row invoice-summary-total">
                    <span>Brutto</span>
                    <span>@Model.GrossAmount.ToString("N2") €</span>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">

    @if (Model.Status == Cashbook.Models.InvoiceStatus.Open)
    {
        <form asp-action="MarkAsPaid"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit" class="btn btn-success">
                Als bezahlt markieren
            </button>
        </form>
    }

    @if (Model.Status != Cashbook.Models.InvoiceStatus.Cancelled)
    {
        <form asp-action="Cancel"
              asp-route-id="@Model.Id"
              method="post"
              onsubmit="return confirm('Möchtest du diese Rechnung wirklich stornieren?');">

            <button type="submit" class="btn btn-outline-danger">
                Rechnung stornieren
            </button>
        </form>
    }

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Zurück
    </a>

</div>