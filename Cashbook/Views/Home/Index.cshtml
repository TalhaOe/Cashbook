@using Cashbook.Models

@{
    ViewData["Title"] = "Dashboard";

    var recentEntries =
        ViewBag.RecentEntries as List<CashEntry>
        ?? new List<CashEntry>();
}

<div class="dashboard-header mb-4">
    <div>
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">
            Überblick über dein Kassenbuch und deine Rechnungen
        </p>
    </div>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-kpi dashboard-kpi-success h-100">
            <div class="card-body">

                <div class="dashboard-kpi-top">
                    <div>
                        <div class="summary-label">
                            Einnahmen
                        </div>

                        <div class="summary-value text-success">
                            @ViewBag.TotalIncome.ToString("N2") €
                        </div>
                    </div>

                    <div class="dashboard-kpi-icon">
                        ↓
                    </div>
                </div>

                <div class="dashboard-kpi-note">
                    Gesamte erfasste Einnahmen
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-kpi dashboard-kpi-danger h-100">
            <div class="card-body">

                <div class="dashboard-kpi-top">
                    <div>
                        <div class="summary-label">
                            Ausgaben
                        </div>

                        <div class="summary-value text-danger">
                            @ViewBag.TotalExpenses.ToString("N2") €
                        </div>
                    </div>

                    <div class="dashboard-kpi-icon">
                        ↑
                    </div>
                </div>

                <div class="dashboard-kpi-note">
                    Gesamte erfasste Ausgaben
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-kpi dashboard-kpi-primary h-100">
            <div class="card-body">

                <div class="dashboard-kpi-top">
                    <div>
                        <div class="summary-label">
                            Kassenstand
                        </div>

                        <div class="summary-value">
                            @ViewBag.Balance.ToString("N2") €
                        </div>
                    </div>

                    <div class="dashboard-kpi-icon">
                        €
                    </div>
                </div>

                <div class="dashboard-kpi-note">
                    Aktueller verfügbarer Bestand
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-kpi dashboard-kpi-warning h-100">
            <div class="card-body">

                <div class="dashboard-kpi-top">
                    <div>
                        <div class="summary-label">
                            Offene Rechnungen
                        </div>

                        <div class="summary-value @(ViewBag.OpenInvoices > 0 ? "text-warning" : "")">
                            @ViewBag.OpenInvoices
                        </div>
                    </div>

                    <div class="dashboard-kpi-icon">
                        #
                    </div>
                </div>

                <div class="dashboard-kpi-note">
                    Noch nicht bezahlte Rechnungen
                </div>

            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-xl-8">
        <div class="card h-100">

            <div class="card-body p-0">

                <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-3">
                    <div>
                        <h4 class="mb-1">Letzte Buchungen</h4>

                        <p class="text-muted small mb-0">
                            Die zuletzt erfassten Kassenbewegungen
                        </p>
                    </div>

                    <a asp-controller="CashEntries"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">
                        Alle anzeigen
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Datum</th>
                                <th>Beschreibung</th>
                                <th>Typ</th>
                                <th class="text-end">Betrag</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var entry in recentEntries)
                            {
                                <tr>
                                    <td>
                                        @entry.Date.ToString("dd.MM.yyyy")
                                    </td>

                                    <td class="fw-semibold">
                                        @entry.Description
                                    </td>

                                    <td>
                                        @if (entry.Type == EntryType.Income)
                                        {
                                            <span class="badge bg-success">
                                                Einnahme
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Ausgabe
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @if (entry.Type == EntryType.Income)
                                        {
                                            <span class="text-success">
                                                +@entry.Amount.ToString("N2") €
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                -@entry.Amount.ToString("N2") €
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!recentEntries.Any())
                            {
                                <tr>
                                    <td colspan="4"
                                        class="text-center py-5">

                                        <div class="dashboard-empty-state">

                                            <div class="dashboard-empty-icon">
                                                €
                                            </div>

                                            <div class="fw-semibold mb-1">
                                                Noch keine Buchungen
                                            </div>

                                            <div class="text-muted small mb-3">
                                                Sobald du Einnahmen oder Ausgaben erfasst,
                                                erscheinen sie hier.
                                            </div>

                                            <a asp-controller="CashEntries"
                                               asp-action="Create"
                                               class="btn btn-sm btn-primary">
                                                Erste Buchung erstellen
                                            </a>

                                        </div>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    </div>


    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-body">

                <h4 class="mb-1">
                    Schnellzugriff
                </h4>

                <p class="text-muted small mb-4">
                    Häufig verwendete Aktionen
                </p>

                <div class="d-grid gap-3">

                    <a asp-controller="CashEntries"
                       asp-action="Create"
                       class="dashboard-quick-action dashboard-quick-primary">

                        <div class="dashboard-quick-icon">
                            +
                        </div>

                        <div>
                            <div class="dashboard-quick-title">
                                Neue Buchung
                            </div>

                            <div class="dashboard-quick-subtitle">
                                Einnahme oder Ausgabe erfassen
                            </div>
                        </div>

                    </a>

                    <a asp-controller="Invoices"
                       asp-action="Create"
                       class="dashboard-quick-action">

                        <div class="dashboard-quick-icon">
                            #
                        </div>

                        <div>
                            <div class="dashboard-quick-title">
                                Neue Rechnung
                            </div>

                            <div class="dashboard-quick-subtitle">
                                Rechnung erstellen
                            </div>
                        </div>

                    </a>

                    <a asp-controller="CashEntries"
                       asp-action="Index"
                       class="dashboard-quick-action">

                        <div class="dashboard-quick-icon">
                            €
                        </div>

                        <div>
                            <div class="dashboard-quick-title">
                                Kassenbuch
                            </div>

                            <div class="dashboard-quick-subtitle">
                                Alle Buchungen anzeigen
                            </div>
                        </div>

                    </a>

                    <a asp-controller="Invoices"
                       asp-action="Index"
                       class="dashboard-quick-action">

                        <div class="dashboard-quick-icon">
                            →
                        </div>

                        <div>
                            <div class="dashboard-quick-title">
                                Rechnungen
                            </div>

                            <div class="dashboard-quick-subtitle">
                                Rechnungen verwalten
                            </div>
                        </div>

                    </a>

                </div>

            </div>
        </div>
    </div>

</div>