@model Cashbook.Models.ViewModels.CashBookIndexViewModel

@{
    ViewData["Title"] = "Kassenbuch";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Kassenbuch</h1>
        <p class="text-muted mb-0">
            Übersicht über deine Einnahmen und Ausgaben
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Neue Buchung
    </a>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card cashbook-summary-card h-100">
            <div class="card-body">
                <div class="summary-label">
                    Einnahmen
                </div>

                <div class="summary-value text-success">
                    @Model.TotalIncome.ToString("N2") €
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card cashbook-summary-card h-100">
            <div class="card-body">
                <div class="summary-label">
                    Ausgaben
                </div>

                <div class="summary-value text-danger">
                    @Model.TotalExpenses.ToString("N2") €
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card cashbook-summary-card h-100">
            <div class="card-body">
                <div class="summary-label">
                    Kassenstand
                </div>

                <div class="summary-value">
                    @Model.Balance.ToString("N2") €
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card">
    <div class="card-body p-0">

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Belegnummer</th>
                        <th>Beschreibung</th>
                        <th class="text-end">Einnahme</th>
                        <th class="text-end">Ausgabe</th>
                        <th class="text-end">Bestand</th>
                        <th class="text-end">Aktionen</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in Model.Entries)
                    {
                        var item = row.Entry;

                        <tr>
                            <td>
                                @item.Date.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                <span class="fw-medium">
                                    @item.ReceiptNumber
                                </span>
                            </td>

                            <td>
                                @item.Description

                                @if (item.InvoiceId.HasValue)
                                {
                                    <span class="badge bg-light text-dark border ms-2">
                                        Rechnung
                                    </span>
                                }
                            </td>

                            <td class="text-end text-success fw-medium">
                                @if (item.Type == Cashbook.Models.EntryType.Income)
                                {
                                    @($"{item.Amount:N2} €")
                                }
                            </td>

                            <td class="text-end text-danger fw-medium">
                                @if (item.Type == Cashbook.Models.EntryType.Expense)
                                {
                                    @($"{item.Amount:N2} €")
                                }
                            </td>

                            <td class="text-end fw-bold">
                                @($"{row.RunningBalance:N2} €")
                            </td>

                            <td class="text-end text-nowrap">

                                @if (item.InvoiceId.HasValue)
                                {
                                    <a asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@item.InvoiceId.Value"
                                       class="btn btn-sm btn-outline-success">
                                        Rechnung
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Bearbeiten
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Löschen
                                    </a>
                                }

                            </td>
                        </tr>
                    }

                    @if (!Model.Entries.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">
                                Noch keine Buchungen vorhanden.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>