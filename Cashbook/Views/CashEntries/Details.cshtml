@model Cashbook.Models.CashEntry

@{
    ViewData["Title"] = "Buchungsdetails";
}

<h1>Buchungsdetails</h1>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Datum
        </dt>
        <dd class="col-sm-10">
            @Model.Date.ToString("dd.MM.yyyy")
        </dd>

        <dt class="col-sm-2">
            Belegnummer
        </dt>
        <dd class="col-sm-10">
            @Model.ReceiptNumber
        </dd>

        <dt class="col-sm-2">
            Beschreibung
        </dt>
        <dd class="col-sm-10">
            @Model.Description
        </dd>

        <dt class="col-sm-2">
            Betrag
        </dt>
        <dd class="col-sm-10">
            @Model.Amount.ToString("N2") €
        </dd>

        <dt class="col-sm-2">
            Typ
        </dt>
        <dd class="col-sm-10">
            @Model.Type
        </dd>

        <dt class="col-sm-2">
            Erstellt am
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Bearbeiten
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Zurück
    </a>
</div>